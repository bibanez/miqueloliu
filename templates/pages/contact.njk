<div class="contact-layout">
      <div class="contact-columns">
        <figure class="contact-image" aria-hidden="true">
          <img src="img/contacte.jpg" alt="" loading="lazy" decoding="async">
        </figure>

        <div class="contact-stack">
          <div class="page-header">
            <h1 data-i18n="contact.title"></h1>
            <p data-i18n="contact.description"></p>
          </div>

        <!-- Direct Contact & Details Section -->
        <section class="contact-block">
          <h2 class="contact-block-title" data-i18n="contact.card.title"></h2>

          <div class="contact-section">
            <p class="contact-label" data-i18n="contact.email.label"></p>
            <div class="email-box">
              <a href="mailto:mqoliu@gmail.com" class="contact-email-link">mqoliu@gmail.com</a>
              <button type="button" id="copy-email-btn" class="copy-btn" aria-label="Copy email address">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                <span id="copy-btn-text" data-i18n="contact.copy.button"></span>
              </button>
            </div>
            <div id="copy-toast" class="copy-toast" aria-live="polite"></div>
            <p class="contact-welcome" data-i18n="contact.email.welcome"></p>
          </div>

          <div class="contact-section">
            <p class="contact-label" data-i18n="contact.location.label"></p>
            <p class="contact-value" data-i18n="contact.location.value"></p>
          </div>

        </section>

        <div class="text-divider" aria-hidden="true"></div>

        <!-- Interactive Contact Form Section -->
        <section class="contact-block">
          <h2 class="contact-block-title" data-i18n="contact.form.title"></h2>

          <form id="contact-form" class="contact-form" action="#" method="post">
            <div class="form-group">
              <label for="contact-subject" data-i18n="contact.form.subject"></label>
              <select id="contact-subject" name="subject" required>
                <option value="" disabled selected data-i18n="contact.form.subject.select"></option>
                <option value="general" data-i18n="contact.form.subject.general"></option>
                <option value="score" data-i18n="contact.form.subject.score"></option>
                <option value="commission" data-i18n="contact.form.subject.commission"></option>
                <option value="other" data-i18n="contact.form.subject.other"></option>
              </select>
            </div>

            <div class="form-group">
              <label for="contact-message" data-i18n="contact.form.message"></label>
              <textarea id="contact-message" name="message" rows="5" required data-i18n-placeholder="contact.form.message.placeholder"></textarea>
            </div>

            <button type="submit" class="submit-btn">
              <span data-i18n="contact.form.send"></span>
            </button>

            <p class="form-notice" data-i18n="contact.form.notice"></p>
            <div id="form-status" class="form-status" aria-live="polite"></div>
          </form>
        </section>
        </div>
      </div>
    </div>
